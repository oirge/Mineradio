+/** Translate and forward a request unchanged; the generic handling of the last branch of
+ * [process_request_w2l], used for the xdg-shell objects that this program passes through. */
+#[allow(clippy::too_many_arguments)]
+fn forward_request(
+    state: &mut WindowToLayer,
+    msg: &[u8],
+    meth: &WaylandMethod,
+    object_id: DownstreamID,
+    alt_id: UpstreamID,
+    version: u32,
+    fds: &mut ArrayVec<OwnedFd, FD_IN_QUEUE_SIZE>,
+    dst: &mut OutputQueue,
+    reverse_dst: &mut OutputQueue,
+) -> Result<ProcResult, WaylandError> {
+    check_space!((msg.len(), meth.fd_count.into()), (0, 0), dst, reverse_dst);
+    create_objects(msg, version, meth, false, &mut state.objs)?;
+    write_translate(msg, meth, false, &state.objs, fds, dst)?;
+    if meth.destructor {
+        generic_destroy_object(&mut state.objs, alt_id, object_id)?;
+    }
+    Ok(ProcResult::Done)
+}

+/** Give an existing downstream-only object an upstream counterpart, as done when an
+ * xdg_surface turns out to belong to a window that is forwarded to xdg-shell instead of
+ * being translated into a layer surface. */
+fn attach_upstream_object(
+    objs: &mut ObjectTracker,
+    downstream_id: DownstreamID,
+    upstream_id: UpstreamID,
+    intf: &'static WaylandInterface,
+    version: u32,
+) -> Result<(), WaylandError> {
+    let Some(obj) = objs.down_to_up.get_mut(&downstream_id) else {
+        return Err(WaylandError::Other(format!(
+            "Tried to attach an upstream object to unknown downstream object {}",
+            downstream_id
+        )));
+    };
+    obj.alt = Some(upstream_id);
+    if objs
+        .up_to_down
+        .insert(
+            upstream_id,
+            UpstreamObject {
+                alt: Some(downstream_id),
+                intf,
+                version,
+                zombie: false,
+            },
+        )
+        .is_some()
+    {
+        return Err(WaylandError::Other(format!(
+            "ID collision when inserting upstream object {}#{}",
+            intf.name, upstream_id
+        )));
+    }
+    Ok(())
+}
+
+/** Create the upstream xdg_surface for a downstream xdg_surface that was kept downstream only
+ * until its role was known, and link the two. Callers must have reserved
+ * [length_xdg_wm_base_req_get_xdg_surface] bytes in `dst` beforehand. */
+fn create_upstream_xdg_surface(
+    state: &mut WindowToLayer,
+    object_id: DownstreamID,
+    wm_base_id: UpstreamID,
+    version: u32,
+    dst: &mut OutputQueue,
+) -> Result<UpstreamID, WaylandError> {
+    let Some(wl_surface_id) = state.xdg_to_wl_surface_map.get(&object_id) else {
+        return Err(WaylandError::Other(
+            "Unexpected xdg_surface: created without associated wl_surface".to_string(),
+        ));
+    };
+    let upstream_wl_surface_id = state.objs.down_to_up[wl_surface_id].alt.unwrap();
+    let upstream_surface_id = get_new_upstream_client_id(&mut state.objs)?;
+    write_xdg_wm_base_req_get_xdg_surface(
+        dst,
+        wm_base_id,
+        upstream_surface_id,
+        upstream_wl_surface_id,
+    );
+    attach_upstream_object(
+        &mut state.objs,
+        object_id,
+        upstream_surface_id,
+        &XDG_SURFACE,
+        version,
+    )?;
+    Ok(upstream_surface_id)
+}

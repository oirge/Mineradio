+/** The xdg_wm_base to forward passed-through xdg-shell objects to, if it can serve a
+ * downstream object bound at `version`. The client's own xdg_wm_base is advertised at the
+ * maximum supported version, so a compositor providing an older xdg-shell must not receive
+ * requests the client made at a version it does not implement. */
+fn passthrough_wm_base(state: &WindowToLayer, version: u32) -> Option<UpstreamID> {
+    let upstream_id = state.upstream_xdg_wm_base?;
+    if state.objs.up_to_down.get(&upstream_id)?.version < version {
+        return None;
+    }
+    Some(upstream_id)
+}
+
+/** True iff this downstream xdg_toplevel is the one backed by a layer surface; every other
+ * toplevel has a real xdg_toplevel upstream and is forwarded unchanged. */
+fn is_layer_toplevel(state: &WindowToLayer, alt_id: Option<UpstreamID>) -> bool {
+    let Some(upstream_id) = alt_id else {
+        return false;
+    };
+    let Some(obj) = state.objs.up_to_down.get(&upstream_id) else {
+        return false;
+    };
+    obj.intf.uid == ZWLR_LAYER_SURFACE_V1.uid
+}
+
+/** True iff this downstream object is an xdg_toplevel forwarded to the compositor's own
+ * xdg-shell, and thus has an upstream object of the same interface. */
+fn is_passthrough_toplevel(state: &WindowToLayer, downstream_id: DownstreamID) -> bool {
+    let Some(upstream_id) = state.objs.down_to_up.get(&downstream_id).and_then(|obj| obj.alt) else {
+        return false;
+    };
+    state
+        .objs
+        .up_to_down
+        .get(&upstream_id)
+        .is_some_and(|obj| obj.intf.uid == XDG_TOPLEVEL.uid)
+}

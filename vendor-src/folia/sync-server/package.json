{
  "name": "folia-sync-server",
  "version": "1.0.0",
  "description": "Sync Server for Folia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "dev:node": "tsx watch src/node.ts",
    "start:node": "tsx src/node.ts",
    "build:node": "tsc"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}

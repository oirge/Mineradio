{
  "schema": "mineradio-plugin-v1",
  "id": "mineradio.theme.graphite",
  "name": "石墨",
  "kind": "theme",
  "version": "1.2.0",
  "author": "Mineradio",
  "theme": {
    "vars": {
      "--panel-glass-shadow": "0 24px 78px rgba(0,0,0,.48),0 0 0 1px rgba(255,255,255,.050),inset 0 1px 0 rgba(255,255,255,.16),inset 0 -18px 42px rgba(0,0,0,.22)",
      "--saved-panel-glass-bg": "rgba(24,24,27,.60)",
      "--saved-panel-glass-shadow": "inset 0 0 2px 1px rgba(255,255,255,.30),inset 0 0 12px 4px rgba(216,216,224,.10),0 12px 34px rgba(0,0,0,.44)",
      "--saved-button-glass-bg": "rgba(30,30,34,.60)",
      "--saved-button-glass-hover-bg": "rgba(216,216,224,.10)",
      "--saved-button-glass-shadow": "inset 0 0 2px 1px rgba(255,255,255,.28),inset 0 0 10px 4px rgba(216,216,224,.09),0 10px 30px rgba(0,0,0,.36)",
      "--saved-button-glass-hover-shadow": "inset 0 0 2px 1px rgba(255,255,255,.40),inset 0 0 12px 5px rgba(216,216,224,.14),0 12px 34px rgba(0,0,0,.42),0 0 18px rgba(216,216,224,.08)",
      "--champagne": "#D8D8E0",
      "--source-local": "#A8A8B2"
    },
    "css": "#search-box,#search-results,.search-mode-tabs,#fx-panel,#playlist-panel,#toast,.modal,.track-detail-modal,.cover-color-pop,.color-lab-pop,.visual-guide-card,.volume-popover,.quality-popover,.mini-queue-popover,.home-hero,.home-card,.home-tile,.home-mosaic-cell,.pl-inline-detail{background:linear-gradient(145deg,rgba(var(--home-accent-rgb),.10),rgba(26,26,30,.90) 44%,rgba(9,9,11,.88))!important}\n#search-box,#search-results,.search-mode-tabs{background:rgba(26,26,30,.58)!important}\n.search-empty{color:rgba(226,226,232,.48)}"
  }
}
